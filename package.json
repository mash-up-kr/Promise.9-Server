{
    "name": "promise9",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "infra"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:nest": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"script/**/*.ts\" \"drizzle.config.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "bun dist/main.js",
        "image-color:preview": "bun run test/manual/image-color-preview.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:backup": "bun run script/backup-db.ts",
        "db:backup:verify": "bun run script/verify-db-backup.ts",
        "db:restore": "bun run script/restore-db.ts",
        "db:health": "bun run script/db-health.ts",
        "db:tunnel": "bun run script/lightsail-db-tunnel.ts",
        "lightsail:ssh": "bun run script/lightsail-db-tunnel.ts --shell",
        "db:seed:list": "bun run script/seed-links-folders.ts",
        "db:seed:master": "bun run script/seed-master-user.ts",
        "db:backfill:embeddings": "bun run script/backfill-link-embeddings.ts",
        "db:visualize_mermaid": "bun run script/visualize-db-mermaid.ts",
        "infra:bootstrap": "bun run --cwd infra bootstrap",
        "infra:synth": "bun run --cwd infra synth",
        "infra:diff": "bun run --cwd infra diff",
        "infra:deploy": "bun run --cwd infra deploy",
        "infra:typecheck": "bun run --cwd infra typecheck",
        "ui": "bun run script/ui/index.ts",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" \"drizzle.config.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" \"drizzle.config.ts\" --fix",
        "test": "bun test src",
        "test:watch": "bun test --watch src",
        "test:cov": "bun test --coverage src",
        "test:debug": "bun test --inspect-brk src",
        "test:e2e": "bun test ./test/app.e2e-spec.ts",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "prepare": "husky"
    },
    "dependencies": {
        "@google/genai": "^2.10.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.4.4",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "google-auth-library": "^10.9.0",
        "jose": "^6.2.8",
        "node-vibrant": "^4.0.4",
        "openai": "^6.45.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sharp": "^0.35.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/bun": "1.3.14",
        "@types/express": "^5.0.0",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.10.7",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.5.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix"
        ]
    }
}
