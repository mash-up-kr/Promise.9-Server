# ─────────────── App ───────────────
APP_ENV=development

# ─────────────── DB ───────────────
DATABASE_URL_DEVELOPMENT=postgres://postgres:postgres@localhost:5432/promise9
DATABASE_URL_PRODUCTION=postgres://user:password@host:5432/promise9?sslmode=verify-full
DB_POOL_SIZE=5

# ─────────────── AI (LLM) ───────────────
LLM_DEFAULT_MODEL=gpt-5.4-mini
LLM_REQUEST_TIMEOUT_MS=30000

# OpenAI
OPENAI_API_KEY=
# Gemini
GEMINI_API_KEY=

# ─────────────── AWS SQS (링크 분석) ───────────────
AWS_REGION=ap-northeast-2
SQS_LINK_ANALYSIS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/promise9-link-analysis
# LocalStack 등 AWS 호환 엔드포인트를 사용할 때만 설정
#SQS_ENDPOINT=http://localhost:4566
# 발행만 담당하는 인스턴스에서는 false로 설정
SQS_CONSUMER_ENABLED=true
# 장기 폴링 대기 시간(1~20초)
SQS_WAIT_TIME_SECONDS=20
# 링크 분석 최대 실행 시간보다 길게 설정(1~43200초)
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# ─────────────── Auth ───────────────
# 필수
JWT_ACCESS_SECRET=your-access-secret-here
# 필수
JWT_REFRESH_SECRET=your-refresh-secret-here
# 선택 | 기본값: 15m
#JWT_ACCESS_EXPIRES_IN=15m
# 선택 | 기본값: 30d
#JWT_REFRESH_EXPIRES_IN=30d
# 필수
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ─────────────── 테스트(마스터 인증) ───────────────
# 선택 | 테스트용 마스터 토큰 (설정 시 해당 토큰으로 인증 우회, 프로덕션 미설정 권장)
#MASTER_ACCESS_TOKEN=
# 선택 | 마스터 토큰으로 인증될 유저 ID | 기본값: 1
#MASTER_USER_ID=1
