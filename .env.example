# ─────────────── App ───────────────
APP_ENV=development

# ─────────────── Grafana / OpenTelemetry ───────────────
# 꺼져 있어도 stdout/stderr JSON 로그와 x-request-id는 유지한다.
OTEL_ENABLED=false
LOG_LEVEL=info
# true일 때 Grafana OpenTelemetry > View connection details의 값을 사용
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-northeast-0.grafana.net/otlp
# 인증 헤더는 비밀값. 실제 토큰을 이 파일이나 커밋에 추가하지 않는다.
#OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64(instance-id:token)>"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=promise9-api
# 로컬을 Grafana의 dev 환경으로 구분할 때 사용. APP_ENV는 development 유지.
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,deployment.environment.name=dev
# 운영 배포에서는 Git commit SHA가 들어간다.
#OTEL_SERVICE_VERSION=local
# 운영은 컨테이너 ID 대신 동일 호스트의 안정적인 Lightsail 인스턴스 식별자를 지정
#OTEL_HOST_ID=your-lightsail-instance-name
# parent-based 비율 샘플링. 1=100%, 0.1=10%; 로그·요청 메트릭에는 적용하지 않음
OTEL_TRACES_SAMPLER_ARG=1

# ─────────────── DB ───────────────
DATABASE_URL_DEVELOPMENT=postgres://postgres:postgres@localhost:5432/promise9
DATABASE_URL_PRODUCTION=postgres://user:password@host:5432/promise9?sslmode=verify-full
DB_POOL_SIZE=5

# ─────────────── AI (LLM) ───────────────
LLM_DEFAULT_MODEL=gpt-5.4-mini
LLM_REQUEST_TIMEOUT_MS=30000

# OpenAI
OPENAI_API_KEY=
# Gemini
GEMINI_API_KEY=

# TinyFish Fetch | 쉼표 구분, 라운드 로빈으로 분산. 중복 키는 하나로 처리
#TINY_FISH_API_KEYS=key-a,key-b,key-c
# 기존 단일 키도 지원. 두 설정이 있으면 TINY_FISH_API_KEYS 우선
#TINY_FISH_API_KEY=key-a

# YouTube Data API v3 | 저장 후 제목·썸네일·설명 우선 수집 (미리보기는 oEmbed)
#YOUTUBE_API_KEY=

# ─────────────── AWS SQS (링크 분석) ───────────────
AWS_REGION=ap-northeast-2
SQS_LINK_ANALYSIS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/promise9-link-analysis
# LocalStack 등 AWS 호환 엔드포인트를 사용할 때만 설정
#SQS_ENDPOINT=http://localhost:4566
# 기본값 false | consumer를 실행할 인스턴스에서만 명시적으로 true로 설정
SQS_CONSUMER_ENABLED=false
# 장기 폴링 대기 시간(1~20초)
SQS_WAIT_TIME_SECONDS=20
# 링크 분석 최대 실행 시간보다 길게 설정(1~43200초)
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# ─────────────── Email (AWS SES) ───────────────
# 선택 | 기본값: ap-northeast-2
#EMAIL_SES_REGION=ap-northeast-2
# EmailService 사용 시 필수 | 실제 메일함을 만들지 않아도 되는 SES 발신 주소
# 배포 스크립트가 출력한 이메일 이미지 버전 URL (미설정 시 CID 첨부)
#EMAIL_ASSET_BASE_URL=https://example.cloudfront.net/email/reminder/<version>
#EMAIL_FROM_ADDRESS=reminder@link-ding-dong.com
# 선택 | SES event publishing용 configuration set
#EMAIL_CONFIGURATION_SET=
# Promise9AppRuntime access key: SQS와 SES가 공통 사용 (이메일 전용 키 사용 금지)
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# 선택 | 임시 자격 증명을 사용하는 경우
#AWS_SESSION_TOKEN=

# ─────────────── Auth ───────────────
# 필수
JWT_ACCESS_SECRET=your-access-secret-here
# 필수
JWT_REFRESH_SECRET=your-refresh-secret-here
# 선택 | 기본값: 15m
#JWT_ACCESS_EXPIRES_IN=15m
# 선택 | 기본값: 30d
#JWT_REFRESH_EXPIRES_IN=30d
# 필수
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# 필수 | Kakao 앱의 REST API 키 (ID 토큰 audience 검증 + code→token 교환에 사용)
KAKAO_CLIENT_ID=your-kakao-rest-api-key
# 선택 | 카카오 로그인 콘솔에서 Client Secret 사용을 켠 경우에만 설정 (기본값 OFF)
#KAKAO_CLIENT_SECRET=
# 필수 | Kakao 앱의 네이티브 앱 키. iOS/Android SDK가 발급하는 id_token의
# audience는 REST API 키가 아니라 이 값이라 별도로 필요함
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
# 필수 | Apple ID 토큰 audience 검증에 사용. iOS 네이티브(Bundle ID)와 웹(Services ID)을
# 동시에 지원하려면 콤마로 구분해서 여러 개 등록 가능 (예: com.mashup.promise9,com.mashup.promise9.web)
APPLE_CLIENT_ID=your-apple-bundle-id-or-services-id

# ─────────────── 테스트(마스터 인증) ───────────────
# 선택 | 테스트용 마스터 토큰 (설정 시 해당 토큰으로 인증 우회, 프로덕션 미설정 권장)
#MASTER_ACCESS_TOKEN=
# 선택 | 마스터 토큰으로 인증될 유저 ID | 기본값: 1
#MASTER_USER_ID=1
