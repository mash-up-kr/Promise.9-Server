{
    "name": "@promise9/infra",
    "version": "0.0.1",
    "private": true,
    "packageManager": "bun@1.3.14",
    "scripts": {
        "build": "node ./node_modules/typescript/bin/tsc",
        "cdk": "node ./node_modules/typescript/bin/tsc && node ./node_modules/aws-cdk/bin/cdk",
        "bootstrap": "node ./node_modules/typescript/bin/tsc && node ./node_modules/aws-cdk/bin/cdk bootstrap",
        "synth": "node ./node_modules/typescript/bin/tsc && node ./node_modules/aws-cdk/bin/cdk synth",
        "diff": "node ./node_modules/typescript/bin/tsc && node ./node_modules/aws-cdk/bin/cdk diff --no-change-set",
        "deploy": "node ./node_modules/typescript/bin/tsc && node ./node_modules/aws-cdk/bin/cdk deploy --require-approval broadening",
        "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
    },
    "dependencies": {
        "aws-cdk-lib": "2.262.1",
        "constructs": "10.7.1"
    },
    "devDependencies": {
        "@types/node": "22.20.1",
        "aws-cdk": "2.1133.0",
        "typescript": "5.9.3"
    }
}
